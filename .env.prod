# ===========================================================================
# TEMPLATE de produção — Dokploy (wmsapaevideira.mlsoftwares.com.br)
# COLE estas variáveis na aba "Environment" do Dokploy e PREENCHA os
# valores marcados como CHANGE_ME / <...>. NÃO versione segredos reais.
# O APP_KEY deve ser gerado com: php artisan key:generate --show
# USUÁRIO E SENHA ADMINISTRADOR: admin@wms.local SENHA: axNG4tw24kHZ4Ut
# ===========================================================================

APP_NAME=WMS
APP_ENV=production
APP_KEY=base64:OvQugIeLw24I/j36zmCT+7MqVhejSsOLd4sdnBuUPMk=
APP_DEBUG=false
APP_URL=https://wmsapaevideira.mlsoftwares.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Fuso horário da aplicação (gravação e exibição de datas — horário de Brasília).
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Banco (serviço "mysql" do docker-compose.prod.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wms_apae
DB_USERNAME=wms_apae
DB_PASSWORD=Apae_Wms_Vide1ra_9Kx2Qm7Rn4Tp8Zc

# --- Sessão (HTTPS via Traefik) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.mlsoftwares.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Filas / Cache (serviço "redis") ---
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (ajuste conforme seu provedor) ---
MAIL_MAILER=log
MAIL_HOST=CHANGE_ME_smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@mlsoftwares.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (websocket) atrás do nginx + Traefik HTTPS ---
REVERB_APP_ID=551030
REVERB_APP_KEY=m07kwwygn5txqkp9qlxp
REVERB_APP_SECRET=eyctwlkhmvk8lm8vg1dw
REVERB_HOST="wmsapaevideira.mlsoftwares.com.br"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Frontend / Sanctum (mesmo domínio em produção) ---
FRONTEND_URL=https://wmsapaevideira.mlsoftwares.com.br
SANCTUM_STATEFUL_DOMAINS=wmsapaevideira.mlsoftwares.com.br
