                "operationId": "046aee406b1237e458cfb8626b3d6e23",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "reason",
