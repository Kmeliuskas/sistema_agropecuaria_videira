    "components": {
        "schemas": {
            "Product": {
                "title": "Produto",
                "required": [
                    "internal_code",
                    "name",
                    "unit_id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "internal_code": {
                        "type": "string",
                        "example": "PROD-0001"
                    },
                    "barcode": {
                        "type": "string",
                        "example": "7890000000001",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "example": "Parafuso Hexagonal 10mm"
                    },
                    "category": {
                        "type": "object",
                        "nullable": true
                    },
                    "unit": {
                        "type": "object",
                        "nullable": true
                    },
                    "min_stock": {
                        "type": "number",
