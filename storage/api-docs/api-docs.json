                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Ajustes"
                ],
                "summary": "Criar ajuste (corrige estoque)",
                "operationId": "e5ce90c013baf1b645eb945bd700ee8e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "product_id": {
                                        "type": "integer"
                                    },
                                    "warehouse_id": {
                                        "type": "integer"
                                    },
                                    "reason": {
                                        "type": "string",
                                        "enum": [
                                            "erro",
                                            "quebra",
                                            "perda",
                                            "roubo",
                                            "vencimento",
                                            "correcao"
                                        ]
                                    },
                                    "quantity": {
                                        "description": "Positivo (ganho) ou negativo (perda)",
                                        "type": "number"
                                    },
                                    "observation": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Criado"
                    },
                    "422": {
                        "description": "Validação"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
